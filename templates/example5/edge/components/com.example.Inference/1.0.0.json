{
  "RecipeFormatVersion": "2020-01-25",
  "ComponentName": "com.example.Inference",
  "ComponentVersion": "1.0.0",
  "ComponentDescription": "Reads sensor telemetry over MQTT, runs an ONNX model with ONNX Runtime and publishes the result to <TopicPrefix>/inference/<thing name>. Minimal example; not run on a device.",
  "ComponentPublisher": "Example",
  "ComponentConfiguration": {
    "DefaultConfiguration": {
      "TopicPrefix": "",
      "ModelFile": "model.onnx",
      "accessControl": {
        "aws.greengrass.ipc.mqttproxy": {
          "com.example.Inference:mqttproxy:1": {
            "policyDescription": "Read sensor telemetry and publish inference results of this device.",
            "operations": ["aws.greengrass#SubscribeToIoTCore", "aws.greengrass#PublishToIoTCore"],
            "resources": ["+/telemetry/+", "+/inference/{iot:thingName}"]
          }
        }
      }
    }
  },
  "Manifests": [
    {
      "Platform": { "os": "linux" },
      "Lifecycle": {
        "Install": "python3 -m pip install --user -r {artifacts:decompressedPath}/inference/requirements.txt",
        "Run": "python3 -u {artifacts:decompressedPath}/inference/main.py --topic-prefix '{configuration:/TopicPrefix}' --thing-name '{iot:thingName}' --model {artifacts:decompressedPath}/inference/{configuration:/ModelFile}"
      },
      "Artifacts": [
        {
          "Uri": "s3://${artifact_bucket}/artifacts/com.example.Inference/1.0.0/inference.zip",
          "Unarchive": "ZIP"
        }
      ]
    }
  ]
}
