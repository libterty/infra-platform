# Naming rules shared with later stacks (design section 8, as v7 K21). These resources do not exist when iam-base is
# applied, so their ARNs are built from names. The stack that creates each resource must use exactly the same name,
# and its tests pin the same strings as tests/iam-base.tftest.hcl:
#   fleet:  thing groups <name_prefix>-fleet, -unverified, -core, -quarantine; things, thing types and IoT policies
#           named <name_prefix>-*
#   ingest: IoT rules named <name_prefix with "-" replaced by "_">_* (rule names cannot contain hyphens)
#   edge:   KVS streams named <name_prefix>-cam-<camera id>
#   cameras: RTSP secrets named <name_prefix>/cameras/<camera id>, created outside Terraform; sitewise and edge reject
#            any other rtsp_secret_arn
#   ml:     model package group <name_prefix>-models, pipeline <name_prefix>-training
locals {
  arn_prefix = {
    iot          = "arn:aws:iot:${var.aws_region}:${var.expected_account_id}"
    sagemaker    = "arn:aws:sagemaker:${var.aws_region}:${var.expected_account_id}"
    kinesisvideo = "arn:aws:kinesisvideo:${var.aws_region}:${var.expected_account_id}"
    iotsitewise  = "arn:aws:iotsitewise:${var.aws_region}:${var.expected_account_id}"
    secrets      = "arn:aws:secretsmanager:${var.aws_region}:${var.expected_account_id}"
    logs         = "arn:aws:logs:${var.aws_region}:${var.expected_account_id}"
    ec2          = "arn:aws:ec2:${var.aws_region}:${var.expected_account_id}"
    ecr          = "arn:aws:ecr:${var.aws_region}:${var.expected_account_id}"
    iam          = "arn:aws:iam::${var.expected_account_id}"
  }

  thing_group_arns = {
    for g in ["fleet", "unverified", "core", "quarantine"] : g => "${local.arn_prefix.iot}:thinggroup/${local.name_prefix}-${g}"
  }
  thing_arn_pattern      = "${local.arn_prefix.iot}:thing/${local.name_prefix}-*"
  thing_type_arn_pattern = "${local.arn_prefix.iot}:thingtype/${local.name_prefix}-*"
  iot_policy_arn_pattern = "${local.arn_prefix.iot}:policy/${local.name_prefix}-*"
  # Certificate IDs are generated by AWS IoT, so certificates cannot be scoped further than the account and region.
  iot_cert_arn_pattern = "${local.arn_prefix.iot}:cert/*"
  iot_rule_arn_pattern = "${local.arn_prefix.iot}:rule/${replace(local.name_prefix, "-", "_")}_*"

  model_package_group_name  = "${local.name_prefix}-models"
  model_package_group_arn   = "${local.arn_prefix.sagemaker}:model-package-group/${local.model_package_group_name}"
  model_package_arn_pattern = "${local.arn_prefix.sagemaker}:model-package/${local.model_package_group_name}/*"
  pipeline_arn              = "${local.arn_prefix.sagemaker}:pipeline/${local.name_prefix}-training"

  # A KVS stream ARN ends in /<creation time>.
  kvs_stream_arn_pattern = "${local.arn_prefix.kinesisvideo}:stream/${local.name_prefix}-cam-*/*"

  # A secret ARN ends in -<6 random characters>, which the trailing * covers.
  camera_secret_arn_pattern = "${local.arn_prefix.secrets}:secret:${local.name_prefix}/cameras/*"
}
